# Gnani.ai API Configuration (Official Vachana Platform)
# Register at https://gnani.ai or developer console to obtain your key
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Optional: Supabase credentials (if connecting cloud PostgreSQL instead of local storage persistence)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
